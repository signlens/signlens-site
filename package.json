{
  "name": "signlens-site",
  "version": "0.1.0",
  "private": true,
  "description": "signlens.dev: what SignLens is, what it shows on real Solana transactions, and how to install it",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signlens/signlens-site.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26.1"
  },
  "scripts": {
    "build": "node src/build.ts",
    "check": "biome check --error-on-warnings . && tsc -p tsconfig.json",
    "format": "biome check --write .",
    "test": "node --test --test-randomize \"test/**/*.test.ts\"",
    "record": "node scripts/record.ts",
    "serve": "node scripts/serve.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "4.149.0"
  }
}
