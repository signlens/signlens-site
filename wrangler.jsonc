// signlens.dev: the static files `npm run build` writes to dist/, behind
// one small script, src/worker.ts, that answers a request for Markdown
// (Accept: text/markdown) with the page's Markdown.
{
    "name": "signlens-site",
    "compatibility_date": "2026-10-20",
    "main": "src/worker.ts",
    // Only signlens.dev serves the site: no copy at signlens-site.<account>.workers.dev.
    "workers_dev": false,
    // Each branch build still gets a preview URL on workers.dev, which
    // _headers marks noindex. Set here, since Wrangler otherwise keeps
    // whatever the dashboard last had.
    "preview_urls": true,
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // Pages go through the script, which hands them on; images go straight to the static files.
        "run_worker_first": ["/*", "!/images/*"],
        // An unknown path gets dist/404.html with a 404 status, not the home page.
        "not_found_handling": "404-page",
        // /privacy serves privacy.html; /privacy.html and /privacy/ redirect to /privacy.
        "html_handling": "auto-trailing-slash"
    }
}
